        }
      }
    },
    "notes land here and file themselves into memory. people, dates, promises, all caught.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट्स यहाँ आते हैं और ख़ुद-ब-ख़ुद याददाश्त में फ़ाइल हो जाते हैं। लोग, तारीख़ें, वादे, सब पकड़ लिए जाते हैं।"
          }
