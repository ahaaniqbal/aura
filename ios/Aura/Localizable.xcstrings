        }
      }
    },
    "Switch on AI chat": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI चैट चालू करें"
          }
        }
      }
    },
    "The free version always keeps reminders, birthdays and your data on this phone. Plus switches on Aura's full AI brain in chat. Pro adds voice, both ways, in English and Hindi.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्री वर्शन में रिमाइंडर, जन्मदिन और आपका डेटा हमेशा इसी फ़ोन पर रहते हैं। Plus चैट में Aura का पूरा AI ब्रेन चालू कर देता है। Pro में वॉयस भी जुड़ जाती है, दोनों तरफ़, इंग्लिश और हिंदी में।"
          }
        }
      }
    },
    "They're obsessed with %@.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वो %@ के दीवाने हैं।"
          }
        }
      }
    },
    "Timed reminders and birthdays fire as real notifications, app closed, scheduled by iOS itself. Place nudges work best with location set to Always, so iOS can wake Aura when you're out.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय वाले रिमाइंडर और जन्मदिन असली नोटिफ़िकेशन की तरह आते हैं, ऐप बंद होने पर भी — iOS ख़ुद इन्हें शेड्यूल करता है। जगह पर याद दिलाना सबसे अच्छा तब चलता है जब लोकेशन Always पर हो, ताकि आपके बाहर होने पर iOS Aura को जगा सके।"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज"
          }
        }
      }
    },
