    },
    "A little note goes a long way.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक छोटा-सा मैसेज भी दिल छू जाता है।"
          }
        }
      }
    },
    "AI & privacy": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI और प्राइवेसी"
          }
        }
      }
    },
    "AI chat is on, via %@": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI चैट चालू है, %@ के ज़रिए"
          }
        }
      }
    },
    "Add context": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जानकारी जोड़ें"
          }
        }
      }
    },
    "Agree and switch on": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहमत हूँ, चालू करें"
          }
        }
      }
    },
    "Allow notifications": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोटिफ़िकेशन की अनुमति दें"
          }
        }
      }
    },
    "Aura Unlimited: ₹5,000 or $199, no daily limit": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura Unlimited: ₹5,000 या $199, कोई रोज़ की सीमा नहीं"
          }
        }
      }
    },
    "Aura will forget everything: people, promises, chat, notes. A backup file stays in the app's documents, your settings stay. Sure?": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura सब कुछ भूल जाएगी: लोग, वादे, चैट, नोट्स। एक बैकअप फ़ाइल ऐप के documents में रहेगी, आपकी सेटिंग्स बनी रहेंगी। पक्का?"
          }
        }
      }
    },
    "Aura, at full strength": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura, पूरी ताक़त के साथ"
          }
        }
      }
    },
    "Aura: ₹3,000 a year in India, $149 outside": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura: भारत में ₹3,000 सालाना, बाहर $149"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटोमैटिक"
          }
        }
      }
    },
    "Before Aura's AI switches on": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura का AI चालू होने से पहले"
          }
        }
      }
    },
    "Birthday": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जन्मदिन"
          }
        }
      }
    },
    "Calendar access is off for Aura. Open Settings": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura के लिए कैलेंडर की अनुमति बंद है। Settings खोलें"
          }
        }
      }
    },
    "Calendar and contacts are read on this phone and never leave it. iPhone gives no app access to SMS or WhatsApp, so Aura does not ask.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर और कॉन्टैक्ट्स इसी फ़ोन पर पढ़े जाते हैं और कहीं नहीं जाते। iPhone किसी ऐप को SMS या WhatsApp की पहुँच नहीं देता, इसलिए Aura माँगती भी नहीं।"
          }
        }
      }
    },
    "Chat": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट"
          }
        }
      }
    },
    "Checking in": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हालचाल"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद करें"
          }
        }
      }
    },
    "Coming up": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आने वाला है"
          }
        }
      }
    },
    "Connect calendar": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर जोड़ें"
          }
        }
      }
    },
    "Connections": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन"
          }
        }
      }
    },
    "Contacts access is off for Aura": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura के लिए कॉन्टैक्ट्स की अनुमति बंद है"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी करें"
          }
        }
      }
    },
    "Debug builds only. A dev key unlocks Pro locally and talks to Gemini directly, no relay needed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ debug बिल्ड के लिए। Dev key लोकल में Pro अनलॉक करती है और सीधे Gemini से बात करती है, रिले की ज़रूरत नहीं।"
          }
        }
      }
    },
    "Decline and Aura still works: reminders, birthdays and the simpler offline brain, with nothing sent anywhere.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मना भी कर दें तो Aura फिर भी काम करती है: रिमाइंडर, जन्मदिन और सादा ऑफ़लाइन ब्रेन, और कुछ भी कहीं नहीं भेजा जाता।"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाएँ"
          }
        }
      }
    },
