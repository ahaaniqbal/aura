      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मस्त"
          }
        }
      }
    },
    "hear you. i'll keep things light today 🤍": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समझ गई। आज सब हल्का रखूँगी 🤍"
          }
        }
      }
    },
    "holding onto \"%@\"": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" संभाल कर रख लिया"
          }
        }
      }
    },
    "how you know them, what matters…": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन्हें कैसे जानते हैं, क्या बात मायने रखती है…"
          }
        }
      }
    },
    "i owe jake a coffee by friday": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुझे शुक्रवार तक जेक को कॉफ़ी पिलानी है"
          }
        }
      }
    },
    "i'll bring \"%@\" back %@": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" %2$@ याद दिला दूँगी"
